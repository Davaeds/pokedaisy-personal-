+void SoftRenderer::SkipScanline(s32 y, int npolys)
+{
+    // PokeDaisy: RenderScanline's walk down each polygon's edges, without drawing (RenderPolygonList's rows above
+    // RowMin): what Render(ShadowMask|Polygon)Scanline change in the renderer and the polygon, nothing else.
+    for (int i = 0; i < npolys; i++)
+    {
+        RendererPolygon* rp = &PolygonList[i];
+        Polygon* polygon = rp->PolyData;
+
+        if (y >= polygon->YTop && (y < polygon->YBottom || (y == polygon->YTop && polygon->YBottom == polygon->YTop)))
+        {
+            PrevIsShadowMask = polygon->IsShadowMask;
+
+            if (polygon->YTop != polygon->YBottom)
+            {
+                if (y >= polygon->Vertices[rp->NextVL]->FinalPosition[1] && rp->CurVL != polygon->VBottom)
+                    SetupPolygonLeftEdge(rp, y);
+                if (y >= polygon->Vertices[rp->NextVR]->FinalPosition[1] && rp->CurVR != polygon->VBottom)
+                    SetupPolygonRightEdge(rp, y);
+            }
+
+            rp->XL = rp->SlopeL.Step();
+            rp->XR = rp->SlopeR.Step();
+        }
+    }
+}
+
+void SoftRenderer::RenderPolygonList(GPU& gpu, Polygon** polygons, int npolys)
+{
+    // PokeDaisy: RenderPolygons for rows [RowMin, RowMax) (see the header), unthreaded.
+    ClearBuffers(gpu);
+
+    int j = 0;
+    for (int i = 0; i < npolys; i++)
+    {
+        if (polygons[i]->Degenerate) continue;
+        SetupPolygon(&PolygonList[j++], polygons[i]);
+    }
+
+    s32 ymin = std::max(0, RowMin), yend = std::min(192, RowMax);
+    for (s32 y = 0; y < yend; y++)
+    {
+        if (y < ymin)
+            SkipScanline(y, j);
+        else
+            RenderScanline(gpu, y, j);
+        // a row's final pass reads the row below it: run once that one is drawn
+        if (y > ymin)
+            ScanlineFinalPass(gpu.GPU3D, y-1);
+    }
+    if (yend > ymin)
+        ScanlineFinalPass(gpu.GPU3D, yend-1);
+}
