---
// The docs' front page: a big search box and every section's pages, with their summaries.
import DocsLayout from '../../layouts/DocsLayout.astro';
import DocSearch from '../../components/DocSearch.astro';
import Pixel from '../../components/Pixel.astro';
import { loadDocs } from '../../lib/docs.js';
import { CREATURE_IDS } from '../../lib/creatures.js';

const docs = loadDocs();
const site = Astro.site ?? new URL('https://pokedaisy.com');
const bySlug = new Map(docs.pages.map((p) => [p.slug, p]));
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'PokeDaisy',
  url: site.href,
  potentialAction: {
    '@type': 'SearchAction',
    target: { '@type': 'EntryPoint', urlTemplate: new URL('/docs/?q={search_term_string}', site).href },
    'query-input': 'required name=search_term_string',
  },
}];
---
<DocsLayout title="PokeDaisy docs: how everything works" description="The PokeDaisy manual: setting up, the companion's tabs, fast-forward, controls, screens and shaders, save states, achievements and troubleshooting." docs={docs} jsonLd={jsonLd} search={false}>
  <section class="doc f-card docs-front">
    <div class="docs-hero">
      <div>
        <p class="doc-crumb">DOCS</p>
        <h1 class="doc-title">How PokeDaisy works</h1>
        <p class="doc-summary">Everything the app does, on one screen or two, in plain words. Search for a button, a setting or a question, or browse the sections below.</p>
      </div>
      <div class="docs-crew" aria-hidden="true">
        {CREATURE_IDS.map((id, i) => <span style={`--i:${i}`}><Pixel name={id} scale={1} /></span>)}
      </div>
    </div>
    <DocSearch big />
    {docs.sections.map((s) => (
      <div class="docs-group" id={s.id}>
        <h2 class="docs-group-title">{s.title}</h2>
        <div class="docs-cards">
          {s.pages.map((slug) => {
            const p = bySlug.get(slug);
            return (
              <a class="docs-card" href={`/docs/${slug}/`}>
                <span class="docs-card-title"><span class="fcur"><Pixel name="cursor" scale={0.667} /></span>{p.title}</span>
                <span class="docs-card-text">{p.summary}</span>
              </a>
            );
          })}
        </div>
      </div>
    ))}
  </section>
</DocsLayout>

<style>
  .docs-hero { display: grid; gap: 18px; margin-bottom: 24px; }
  .docs-crew { display: flex; gap: 10px; align-items: flex-end; flex-wrap: wrap; }
  .docs-crew span { animation: bob 1.2s steps(2) infinite; animation-delay: calc(var(--i) * -0.24s); }
  .docs-group { margin-top: 40px; scroll-margin-top: 100px; }
  .docs-group-title { font-size: var(--t-l); letter-spacing: 0.0625em; text-shadow: var(--bold); margin-bottom: 14px; }
  .docs-cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 12px; }
  .docs-card { display: grid; gap: 6px; padding: 14px 16px; text-decoration: none; background: #f7f6fb; border: var(--px) solid transparent; }
  .docs-card:hover { background: #fff; border-color: var(--ink); }
  .docs-card .fcur { display: inline-flex; width: 0; overflow: hidden; transition: width 0.12s steps(2); }
  .docs-card:hover .fcur { width: 14px; }
  .docs-card-title { display: flex; align-items: center; gap: 4px; font-size: var(--t-s); line-height: 1.2; }
  .docs-card-text { font: 15px/1.45 'Atkinson Hyperlegible', system-ui, sans-serif; color: var(--ink-2); }
</style>
