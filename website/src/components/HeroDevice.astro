---
// A dual-screen handheld in pixels, laid out like the AYN Thor: a wide 16:9 top screen in a thin
// bezel, a two-piece hinge, and below it the small screen between the controls - left stick over the
// d-pad, ABXY over the right stick, the small menu buttons under the screen, speaker grilles. The top
// screen is HeroScene's overworld; the bottom one plays the companion's PARTY tab.
import Pixel from './Pixel.astro';
import PartyDemo from './PartyDemo.astro';
import HeroScene from './HeroScene.astro';

interface Props { still?: boolean }
const { still = false } = Astro.props;
---
<div class:list={['device', still && 'still']}>
  <div class="lid f-thorShell">
    <div class="bezel f-bezel">
      <div class="topscreen">
        <HeroScene lines={['Your party is on the bottom screen.', 'So are the map, the bag and your dex.', 'In a battle, every matchup is a glance away.']} />
      </div>
    </div>
  </div>
  <div class="hinge"></div>
  <div class="base f-thorShell">
    <div class="side">
      <span class="ctl stick"><Pixel name="thorStick" scale={1.5} /></span>
      <span class="ctl"><Pixel name="thorDpad" scale={1.5} /></span>
      <span class="mini"></span>
    </div>
    <div class="middle">
      <div class="bezel f-bezel low"><PartyDemo compact /></div>
      <div class="menu-keys"><i></i><i class="home"></i><i></i></div>
    </div>
    <div class="side">
      <span class="ctl"><Pixel name="thorAbxy" scale={1.5} /></span>
      <span class="ctl stick"><Pixel name="thorStick" scale={1.5} /></span>
      <span class="mini"></span>
    </div>
    <span class="grille left"></span>
    <span class="grille right"></span>
  </div>
</div>

<style is:global>
  .device { width: 100%; max-width: 560px; margin: 0 auto; filter: drop-shadow(calc(var(--px) * 4) calc(var(--px) * 4) 0 rgba(29, 27, 38, 0.16)); }
  .device .lid { padding: 0; }
  .device .bezel { display: block; }
  /* The Thor's hinge: one long cylinder across the base's top edge. */
  .device .hinge {
    width: 94%; height: calc(var(--px) * 8); margin: 0 auto;
    background: linear-gradient(#5a5a68 0 calc(var(--px) * 1), #3a3a46 calc(var(--px) * 1) calc(var(--px) * 3), #2a2a34 calc(var(--px) * 3) calc(var(--px) * 6), #16161c calc(var(--px) * 6));
    box-shadow: 0 0 0 var(--px) #0c0c10;
    clip-path: polygon(calc(var(--px) * 2) 0, calc(100% - var(--px) * 2) 0, 100% calc(var(--px) * 2), 100% calc(100% - var(--px) * 2), calc(100% - var(--px) * 2) 100%, calc(var(--px) * 2) 100%, 0 calc(100% - var(--px) * 2), 0 calc(var(--px) * 2));
  }

  /* The base: big round controls either side of the small screen, as on the Thor. */
  .device .base { position: relative; display: grid; grid-template-columns: 1fr minmax(0, 50%) 1fr; gap: calc(var(--px) * 2); align-items: stretch; padding-block: calc(var(--px) * 3); }
  .device .side { display: grid; justify-items: center; align-content: start; gap: calc(var(--px) * 4); padding-top: calc(var(--px) * 2); }
  .device .ctl { display: block; width: 86%; }
  .device .ctl .pixel { width: 100%; height: auto; aspect-ratio: 1; }
  .device .stick { animation: glow 2.4s steps(2) infinite; }
  @keyframes glow { 50% { filter: brightness(1.2) saturate(1.2); } }
  .device .mini { width: calc(var(--px) * 5); height: calc(var(--px) * 5); margin-bottom: calc(var(--px) * 2); background: #2e2e38; box-shadow: 0 0 0 var(--px) #0c0c10, inset var(--px) var(--px) 0 #4a4a58;
    clip-path: polygon(30% 0, 70% 0, 100% 30%, 100% 70%, 70% 100%, 30% 100%, 0 70%, 0 30%); }
  .device .middle { display: grid; gap: calc(var(--px) * 3); align-content: start; }
  .device .bezel.low { width: 100%; }
  .device .bezel.low .appwrap { max-width: none; }
  .device .menu-keys { display: flex; justify-content: center; gap: calc(var(--px) * 6); }
  .device .menu-keys i { width: calc(var(--px) * 8); height: calc(var(--px) * 3); background: #33333f; box-shadow: 0 0 0 var(--px) #0c0c10, inset 0 var(--px) 0 #4e4e5c; }
  .device .menu-keys i.home { width: calc(var(--px) * 4); height: calc(var(--px) * 4); margin-top: calc(var(--px) * -0.5); }
  .device .grille { position: absolute; bottom: calc(var(--px) * 3); width: calc(var(--px) * 10); height: calc(var(--px) * 3);
    background: radial-gradient(circle, #0c0c10 0 calc(var(--px) * 0.6), transparent calc(var(--px) * 0.7)) 0 0 / calc(var(--px) * 2) calc(var(--px) * 1.5); }
  .device .grille.left { left: calc(var(--px) * 9); }
  .device .grille.right { right: calc(var(--px) * 9); }

  .device.still * { animation: none !important; }
</style>
